# Vercel AI Gateway Configuration
# Doc: https://vercel.com/docs/ai-gateway
#
# AI Gateway API Key (Required)
# Create one at: Vercel Dashboard → AI Gateway → API Keys → Create Key
# Format: ai-gw_xxxxxxxxxxxxxxx
VITE_VERCEL_AI_API_KEY=

# (Optional) Custom base URL for self-hosted or region-specific gateways
# Default: https://ai-gateway.vercel.sh/v1
# VITE_VERCEL_AI_BASE_URL=https://ai-gateway.vercel.sh/v1

# (Required) Comma-separated list of models to show in the model picker
# Format: <provider/model-id>|<Display Name>,<provider/model-id-2>|<Display Name 2>
# Common models:
#   openai/gpt-4.1-mini
#   openai/gpt-4.1
#   anthropic/claude-sonnet-4
#   anthropic/claude-opus-4
#   google/gemini-3.1-pro-preview
#   google/gemini-3.5-flash
#   xai/grok-3
#   deepseek/deepseek-r1
VITE_VERCEL_AI_MODELS=openai/gpt-4.1-mini|GPT 4.1 Mini,anthropic/claude-sonnet-4|Claude Sonnet 4,google/gemini-3.5-flash|Gemini 3.5 Flash,xai/grok-3|Grok 3
